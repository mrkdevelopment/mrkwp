<?xml version="1.0"?>
<ruleset name="MRK WP Theme">
	<description>PHP_CodeSniffer ruleset for MRK WP Theme.</description>

	<!-- Scan all PHP files in directory -->
	<file>.</file>

	<!-- Only scan PHP files -->
	<arg name="extensions" value="php" />

	<!-- Show sniff codes and progress -->
	<arg value="sp" />
	<arg name="colors" />

	<!-- Exclude build, cache, and vendor directories -->
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<!-- Rule: WordPress Standard -->
	<rule ref="WordPress">
		<!-- Exclude filename sniff so standard WP template names like front-page.php, page-about.php work without error -->
		<exclude name="WordPress.Files.FileName" />
		<!-- Exclude reserved keyword parameter names check (e.g., $class in helper functions) -->
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames.classFound" />
	</rule>

	<!-- Allow standard WordPress block pattern headers without standard PHP file docblocks -->
	<rule ref="Squiz.Commenting.FileComment">
		<exclude-pattern>*/patterns/*</exclude-pattern>
	</rule>

	<!-- Verify that strings use the proper text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mrkwp" />
				<element value="ollie" />
			</property>
		</properties>
	</rule>
</ruleset>
