{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1320px"
    },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "ink",
          "color": "#0a2540",
          "name": "Ink (Headings & Dark BG)"
        },
        {
          "slug": "body",
          "color": "#425466",
          "name": "Body Text"
        },
        {
          "slug": "canvas",
          "color": "#f8fafc",
          "name": "Canvas (Light BG)"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "indigo",
          "color": "#554cf0",
          "name": "Indigo (Primary Accent)"
        },
        {
          "slug": "indigo-dark",
          "color": "#463cd7",
          "name": "Indigo Dark (Hover)"
        },
        {
          "slug": "indigo-subtle",
          "color": "#eae8ff",
          "name": "Indigo Subtle"
        },
        {
          "slug": "cyan",
          "color": "#00d4ff",
          "name": "Cyan (Vibrant Accent)"
        },
        {
          "slug": "deep-cyan",
          "color": "#007a99",
          "name": "Deep Cyan"
        },
        {
          "slug": "accent-cyan",
          "color": "#006c86",
          "name": "Accent Cyan (Eyebrow)"
        },
        {
          "slug": "night",
          "color": "#051322",
          "name": "Night (Navy Section BG)"
        },
        {
          "slug": "line",
          "color": "#dfe5ec",
          "name": "Line (Border)"
        },
        {
          "slug": "line-strong",
          "color": "#cbd6e4",
          "name": "Line Strong"
        },
        {
          "slug": "muted",
          "color": "#637386",
          "name": "Muted"
        },
        {
          "slug": "surface-alt",
          "color": "#edf1f8",
          "name": "Surface Alt (Bento BG)"
        },
        {
          "slug": "surface-hover",
          "color": "#e9edff",
          "name": "Surface Hover"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
          "slug": "inter",
          "name": "Inter"
        },
        {
          "fontFamily": "\"Plus Jakarta Sans\", sans-serif",
          "slug": "plus-jakarta-sans",
          "name": "Plus Jakarta Sans"
        },
        {
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
          "slug": "monospace",
          "name": "Monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "14px",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "16px",
          "name": "Normal"
        },
        {
          "slug": "lead",
          "size": "18px",
          "name": "Lead"
        },
        {
          "slug": "large",
          "size": "24px",
          "name": "H3 / Large"
        },
        {
          "slug": "x-large",
          "size": "36px",
          "name": "H2 Bento / XL"
        },
        {
          "slug": "2x-large",
          "size": "48px",
          "name": "H2 Section / 2XL"
        },
        {
          "slug": "hero",
          "size": "clamp(60px, 6.45vw, 91px)",
          "name": "Hero Display"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--body)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "elements": {
      "h1": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontWeight": "700",
          "letterSpacing": "-0.055em",
          "lineHeight": "1.05"
        }
      },
      "h2": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontWeight": "700",
          "letterSpacing": "-0.045em",
          "lineHeight": "1.1"
        }
      },
      "h3": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontWeight": "600",
          "letterSpacing": "-0.035em",
          "lineHeight": "1.25"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--indigo)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "16px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontWeight": "600",
          "fontSize": "16px",
          "lineHeight": "1.4"
        },
        "spacing": {
          "padding": {
            "top": "15px",
            "bottom": "15px",
            "left": "23px",
            "right": "23px"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "variations": {
          "secondary": {
            "color": {
              "background": "#ffffff",
              "text": "var(--wp--preset--color--ink)"
            },
            "border": {
              "color": "#aebcd0",
              "width": "1px",
              "style": "solid",
              "radius": "16px"
            }
          },
          "light": {
            "color": {
              "background": "#ffffff",
              "text": "var(--wp--preset--color--ink)"
            },
            "border": {
              "radius": "16px"
            }
          },
          "small": {
            "typography": {
              "fontSize": "13px"
            },
            "spacing": {
              "padding": {
                "top": "11px",
                "bottom": "11px",
                "left": "18px",
                "right": "18px"
              }
            }
          },
          "text-link": {
            "color": {
              "background": "transparent",
              "text": "var(--wp--preset--color--ink)"
            },
            "border": {
              "width": "0px"
            },
            "spacing": {
              "padding": {
                "top": "0px",
                "bottom": "0px",
                "left": "0px",
                "right": "0px"
              }
            }
          }
        }
      },
      "core/paragraph": {
        "variations": {
          "eyebrow": {
            "color": {
              "text": "var(--wp--preset--color--accent-cyan)"
            },
            "typography": {
              "fontFamily": "var(--wp--preset--font-family--plus-jakarta-sans)",
              "fontSize": "15px",
              "fontWeight": "700",
              "letterSpacing": "0.06em",
              "textTransform": "uppercase",
              "lineHeight": "1.6"
            }
          },
          "lead": {
            "typography": {
              "fontSize": "18px",
              "lineHeight": "1.8"
            }
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}